[clientscript,spawn_menu_set_scrollsize](component $grid, component $scrollbar, int $height)
// Called every search with the real row count. Re-invoking scrollbar_vertical alongside
// if_setscrollsize is needed for the dragger's own size to update, not just the scroll range
// (matches [clientscript,ge_history_finish].cs2's own refresh pattern).
if_setscrollsize(0, $height, $grid);
~scrollbar_vertical($scrollbar, $grid, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
