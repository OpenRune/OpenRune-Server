[[interface]]
name = "interface.spawn_menu"
width = 512
height = 334
on_load = ["clientscript.spawn_menu_init", "component.spawn_menu:border", "component.spawn_menu:searchbar", "component.spawn_menu:searchtext", "component.spawn_menu:grid", "component.spawn_menu:scrollbar", "component.spawn_menu:status"]

[[component]]
name = "border"
type = "layer"
width = 512
height = 334
no_click_through = true

[[component]]
name = "searchbar"
type = "layer"
x = 394
y = 40
width = 100
height = 20

[[component]]
name = "content"
type = "layer"
x = 10
y = 36
width = 492
height = 28

[[component]]
name = "searchtext"
type = "text"
parent = "content"
x = 384
y = 4
width = 100
height = 20
options = ["Search"]
text = "*"
font = "regular"
h_align = "center"
v_align = "center"
color = "#FF981F"

[[component]]
name = "qtybtn0"
type = "layer"
parent = "content"
x = 8
y = 4
width = 48
height = 20
options = ["Select"]

[[component]]
name = "qtybtn1"
type = "layer"
parent = "content"
x = 60
y = 4
width = 48
height = 20
options = ["Select"]

[[component]]
name = "qtybtn2"
type = "layer"
parent = "content"
x = 112
y = 4
width = 48
height = 20
options = ["Select"]

[[component]]
name = "qtybtn3"
type = "layer"
parent = "content"
x = 164
y = 4
width = 48
height = 20
options = ["Select"]

[[component]]
name = "notebtn"
type = "layer"
parent = "content"
x = 216
y = 4
width = 48
height = 20
options = ["Toggle"]

[[component]]
name = "bankbtn"
type = "layer"
parent = "content"
x = 268
y = 4
width = 48
height = 20
options = ["Toggle"]

[[component]]
name = "nullbtn"
type = "layer"
parent = "content"
x = 320
y = 4
width = 56
height = 20
options = ["Toggle"]

[[component]]
name = "grid"
type = "layer"
x = 10
y = 64
width = 474
height = 260

[[component]]
name = "message"
type = "layer"
x = 10
y = 64
width = 474
height = 260

[[component]]
name = "status"
type = "text"
parent = "message"
width = 474
height = 260
text = "Start typing to find items"
font = "bold"
h_align = "center"
v_align = "center"
color = "#FF981F"

[[component]]
name = "scrollbar"
type = "layer"
x = 486
y = 64
width = 16
height = 260
