[clientscript,spawn_menu_set_tooltip](component $target, string $name)
// Replaces the earlier cc_find-based attempt, which was wrong: cc_find(container, subid) only
// locates children created dynamically at runtime with an explicit subid (e.g. bank/toolbelt item
// grids built via cc_create) - it doesn't apply to statically declared sibling components like our
// slot0..slot(N-1), which don't have subids at all (cc_find returned false every time, so
// cc_setopbase never ran). if_setopbase(text, component) sets opbase directly on an explicit
// component reference instead, with no find/subid step - the right tool for our shape, confirmed
// present in the real CS2 command set (.prelude/interface.cs2).
//
// Called once per populated slot from Kotlin (SpawnMenuScript.renderSlots), right after that
// slot's own ifSetObj call - not batched, since if_setopbase only takes one target component at a
// time and CS2 has no component-array parameter type to hand it a whole grid's worth at once.
if_setopbase($name, $target);
