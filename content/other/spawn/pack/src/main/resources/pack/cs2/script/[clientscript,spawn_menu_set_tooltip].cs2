[clientscript,spawn_menu_set_tooltip](component $target, string $name)
// Sets the hover text ("Spawn <item name>") directly on an explicit component reference.
// Deliberately not cc_find + cc_setopbase: cc_find(container, subid) only locates children
// created dynamically at runtime with an explicit subid (e.g. bank/toolbelt item grids built via
// cc_create) - it doesn't apply to our slot0..slot(N-1), which are statically declared sibling
// components with no subid at all. if_setopbase(text, component) is the direct-addressing
// equivalent and is what actually works for this shape.
//
// Called once per populated slot from Kotlin (SpawnMenuScript.renderSlots), right after that
// slot's own ifSetObj call - not batched, since if_setopbase only takes one target component at a
// time and CS2 has no component-array parameter type to hand it a whole grid's worth at once.
if_setopbase($name, $target);
