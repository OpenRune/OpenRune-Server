[[interface]]
name = "interface.commands_menu"
width = 512
height = 334
on_load = ["clientscript.commands_menu_init", "component.commands_menu:frame", "component.commands_menu:categories_panel", "component.commands_menu:list_panel", "component.commands_menu:details_panel", "component.commands_menu:previous", "component.commands_menu:next", "component.commands_menu:use"]

[[component]]
name = "frame"
type = "layer"
x = 0
y = 0
width = 512
height = 334
no_click_through = true

