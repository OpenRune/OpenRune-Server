[[interface]]
name = "interface.commands_menu"
# Keep this interface standalone for revision 240. The current FileStore inherit merger
# resolves an overlay back onto the inherited base id/name, which would make the
# component.commands_menu:* mappings point at the wrong interface.
width = 512
height = 334

[[component]]
name = "commands_blocker"
type = "layer"
x = 18
y = 56
width = 476
height = 254
no_click_through = true

[[component]]
name = "commands_panel"
type = "rectangle"
x = 18
y = 56
width = 476
height = 254
color = "#211D17"
filled = true

[[component]]
name = "title"
type = "text"
x = 145
y = 10
width = 222
height = 20
text = "Commands"
font = "bold"
line_height = 14
h_align = "center"
v_align = "center"
color = "#FF981F"

