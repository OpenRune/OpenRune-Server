[proc,toolbelt_build](component $content, component $scrollbar)
cc_deleteall($content);
def_int $y = 0;
def_int $step = 40;
def_int $cat = 0;
def_int $cols = 0;
def_int $max = 0;
def_int $col = 0;
def_int $x = 0;
def_int $slot = 0;
def_int $bg = 0;
def_int $item = 0;
def_int $lock = 0;
def_int $header = 0;
def_string $name = "";
def_string $title = "";
def_dbrow $row = null;
while ($cat < 5) {
    $max = ~toolbelt_count_category($cat);
    $header = calc(100 + $cat);
    $cols = $max;
    if ($cols > 8) {
        $cols = 8;
    }
    $name = enum(int, string, toolbelt_categories, $cat);
    $title = "<$name> - 0/<tostring($max)>";
    cc_create($content, ^iftype_text, $header);
    cc_setposition(0, $y, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(0, 18, ^setsize_minus, ^setsize_abs);
    cc_settextfont(b12_full);
    cc_settextshadow(true);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    cc_setcolour(0xffcb1f);
    cc_settext($title);
    $y = calc($y + 18 + 6);
    $col = 0;
    $slot = 0;
    while ($slot < 28) {
        if (db_find(toolbelt_slots:slot_index, $slot) = 1) {
            $row = db_findnext;
            if ($row ! null & db_getfield($row, toolbelt_slots:category, 0) = $cat) {
                $bg = calc(200 + $slot);
                $item = calc(300 + $slot);
                $lock = calc(400 + $slot);
                $x = calc($col * $step);
                cc_create($content, ^iftype_graphic, $bg);
                cc_setsize(36, 36, ^setsize_abs, ^setsize_abs);
                cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic(square_button_disabled);
                cc_create($content, ^iftype_graphic, $item);
                cc_setsize(36, 36, ^setsize_abs, ^setsize_abs);
                cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
                cc_setoutline(1);
                cc_setgraphicshadow(0x000000);
                cc_setonop("cc_settrans_temporarily(event_com, event_comsubid, 125, 0)");
                cc_create($content, ^iftype_graphic, $lock);
                cc_setposition(calc($x + 6), calc($y + 2), ^setpos_abs_left, ^setpos_abs_top);
                cc_setgraphic("magic_spell_padlocks,0");
                cc_setsize(30, 30, ^setsize_abs, ^setsize_abs);
                cc_sethide(true);
                $col = calc($col + 1);
                if ($col >= $cols) {
                    $col = 0;
                    $y = calc($y + $step);
                }
            }
        }
        $slot = calc($slot + 1);
    }
    if ($col ! 0) {
        $y = calc($y + $step);
    }
    $y = calc($y + 6);
    $cat = calc($cat + 1);
}
if ($y > if_getheight($content)) {
    if_setscrollsize(0, $y, $content);
    ~scrollbar_vertical($scrollbar, $content, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
} else {
    if_setscrollsize(0, 0, $content);
    cc_deleteall($scrollbar);
}
