[clientscript,toolbelt_filter](component $content, component $search, component $scrollbar, component $border)
def_string $needle = "";
def_obj $obj = null;
def_int $slot = 0;
def_int $item = 0;
def_int $y = 0;
def_int $step = 40;
def_boolean $match = false;
def_boolean $any_general = false;
def_boolean $any_farming = false;
def_boolean $any_fishing = false;
def_boolean $any_crafting = false;
def_boolean $any_misc = false;
def_int $cat = 0;
def_int $c = 0;
def_int $header = 0;
def_boolean $any = false;
def_int $cols = 0;
def_int $col = 0;
def_int $bg = 0;
def_int $lock = 0;
def_int $x = 0;
def_dbrow $row = null;
def_obj $ghost = null;
def_boolean $owned = false;
def_int $stored = 0;
def_int $allowed = 0;
def_boolean $locked = false;
if (cc_find($search, 3) = true) {
    $needle = lowercase(~string_trim(removetags(cc_gettext)));
}
if (compare($needle, "") = 0) {
    ~toolbelt_build($content, $scrollbar);
    ~toolbelt_draw($content, $border);
    return;
}
while ($slot < 28) {
    $match = false;
    $item = calc(300 + $slot);
    $obj = null;
    $ghost = null;
    $owned = false;
    $row = null;
    if (db_find(toolbelt_slots:slot_index, $slot) = 1) {
        $row = db_findnext;
        if ($row ! null) {
            if (db_getfieldcount($row, toolbelt_slots:allowed_items) > 0) {
                $ghost = db_getfield($row, toolbelt_slots:allowed_items, 0);
            }
        }
    }
    $stored = 0;
    if ($row ! null) {
        $stored = ~toolbelt_stored_for_row($row);
        if ($stored > 0) {
            $allowed = db_getfieldcount($row, toolbelt_slots:allowed_items);
            if ($stored <= $allowed) {
                $obj = db_getfield($row, toolbelt_slots:allowed_items, calc($stored - 1));
                $owned = true;
            }
        }
    }
    if ($owned = false) {
        $obj = $ghost;
    }
    if (cc_find($content, $item) = true) {
        if ($obj ! null & string_indexof_string(lowercase(oc_name($obj)), $needle, 0) ! -1) {
            $match = true;
        }
        if ($match = true) {
            cc_sethide(false);
            if (cc_find($content, calc(200 + $slot)) = true) {
                cc_sethide(false);
            }
            $lock = calc(400 + $slot);
            $locked = false;
            if ($slot = 27 & testbit(%toolbelt_unlocks, 0) = ^false) {
                $locked = true;
            }
            if (cc_find($content, $lock) = true) {
                if ($locked = true) {
                    cc_sethide(false);
                } else {
                    cc_sethide(true);
                }
            }
            if ($row ! null) {
                $c = db_getfield($row, toolbelt_slots:category, 0);
                if ($c = 0) {
                    $any_general = true;
                } else if ($c = 1) {
                    $any_farming = true;
                } else if ($c = 2) {
                    $any_fishing = true;
                } else if ($c = 3) {
                    $any_crafting = true;
                } else {
                    $any_misc = true;
                }
            }
        } else {
            cc_sethide(true);
            if (cc_find($content, calc(200 + $slot)) = true) {
                cc_sethide(true);
            }
            if (cc_find($content, calc(400 + $slot)) = true) {
                cc_sethide(true);
            }
        }
    }
    $slot = calc($slot + 1);
}
while ($cat < 5) {
    $header = calc(100 + $cat);
    $cols = ~toolbelt_count_category($cat);
    if ($cols > 8) {
        $cols = 8;
    }
    if ($cat = 0) {
        $any = $any_general;
    } else if ($cat = 1) {
        $any = $any_farming;
    } else if ($cat = 2) {
        $any = $any_fishing;
    } else if ($cat = 3) {
        $any = $any_crafting;
    } else {
        $any = $any_misc;
    }
    if ($any = false) {
        if (cc_find($content, $header) = true) {
            cc_sethide(true);
        }
    } else {
        if (cc_find($content, $header) = true) {
            cc_sethide(false);
            cc_setposition(0, $y, ^setpos_abs_left, ^setpos_abs_top);
        }
        $y = calc($y + 18 + 6);
        $col = 0;
        $slot = 0;
        while ($slot < 28) {
            if (db_find(toolbelt_slots:slot_index, $slot) = 1) {
                $row = db_findnext;
                if ($row ! null & db_getfield($row, toolbelt_slots:category, 0) = $cat) {
                    $item = calc(300 + $slot);
                    $bg = calc(200 + $slot);
                    $lock = calc(400 + $slot);
                    if (cc_find($content, $item) = true & cc_gethide = false) {
                        $x = calc($col * $step);
                        cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
                        if (cc_find($content, $bg) = true) {
                            cc_sethide(false);
                            cc_setposition($x, $y, ^setpos_abs_left, ^setpos_abs_top);
                        }
                        if (cc_find($content, $lock) = true) {
                            if ($slot = 27 & testbit(%toolbelt_unlocks, 0) = ^false) {
                                cc_sethide(false);
                                cc_setposition(calc($x + 6), calc($y + 2), ^setpos_abs_left, ^setpos_abs_top);
                            } else {
                                cc_sethide(true);
                            }
                        }
                        $col = calc($col + 1);
                        if ($col >= $cols) {
                            $col = 0;
                            $y = calc($y + $step);
                        }
                    } else if (cc_find($content, $bg) = true) {
                        cc_sethide(true);
                    }
                }
            }
            $slot = calc($slot + 1);
        }
        if ($col ! 0) {
            $y = calc($y + $step);
        }
        $y = calc($y + 6);
    }
    $cat = calc($cat + 1);
}
if ($y > if_getheight($content)) {
    if_setscrollsize(0, $y, $content);
    ~scrollbar_vertical($scrollbar, $content, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
} else {
    if_setscrollsize(0, 0, $content);
    cc_deleteall($scrollbar);
}
